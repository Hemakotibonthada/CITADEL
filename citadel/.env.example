# ============================================================
#  CITADEL — Environment Configuration
#  Copy to `.env` and fill in your values.
# ============================================================

# ── Broker Configuration ───────────────────────────────────
BROKER_API_KEY=your_broker_api_key_here
BROKER_API_SECRET=your_broker_api_secret_here
BROKER_ENDPOINT=https://api.broker.example.com
BROKER_ACCOUNT_ID=your_account_id
BROKER_PAPER_TRADING=true

# ── News & Data APIs ──────────────────────────────────────
NEWS_API_KEY=your_newsapi_key
ALPHA_VANTAGE_KEY=your_alphavantage_key
FINNHUB_API_KEY=your_finnhub_key

# ── Polygon / Massive (Market Data) ──────────────────────
POLYGON_API_KEY=your_polygon_access_key_id
POLYGON_SECRET_KEY=your_polygon_secret_key
POLYGON_S3_ENDPOINT=https://files.massive.com
POLYGON_S3_BUCKET=flatfiles

# ── Email / Report Delivery ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
REPORT_RECIPIENT=your_email@gmail.com

# ── Hardware Acceleration ─────────────────────────────────
# Options: auto, cpu, intel_npu, intel_gpu, apple_metal
COMPUTE_DEVICE=auto
OPENVINO_MODEL_PATH=models/deepseek-r1-distill
MLX_MODEL_PATH=models/deepseek-r1-distill-mlx

# ── LLM Configuration ────────────────────────────────────
LLM_MODEL_ID=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3
LLM_CONTEXT_LENGTH=8192

# ── System Configuration ─────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
DATA_DIR=./data
SHARED_MEMORY_SIZE_MB=256
MAX_WORKERS=4
HEARTBEAT_INTERVAL_MS=500

# ── Risk Parameters ──────────────────────────────────────
MAX_PORTFOLIO_LEVERAGE=2.0
MAX_SINGLE_POSITION_PCT=10.0
DAILY_LOSS_LIMIT_PCT=3.0
CORRELATION_BREACH_THRESHOLD=0.85
FAT_FINGER_MULTIPLIER=5.0

# ── Training ─────────────────────────────────────────────
LORA_RANK=8
LORA_ALPHA=16
LORA_EPOCHS=3
TRAINING_SCHEDULE_CRON=0 17 * * 1-5
