{
  "name": "citadel-project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "concurrently -k -n backend,frontend -c cyan,magenta \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "set PYTHONUNBUFFERED=1 && .venv\\Scripts\\python.exe -u citadel\\run_citadel.py",
    "start:frontend": "npm run dev --prefix citadel/src-ui"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
